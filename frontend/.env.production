# Production environment variables for frontend
# IMPORTANT for Railway: set REACT_APP_API_BASE to your backend's HTTPS URL
# Example: REACT_APP_API_BASE=https://backend-production-xxxx.up.railway.app
# Leaving it empty will make the app use same-origin relative paths ("/api")
# which only works if you proxy backend behind the same domain.
REACT_APP_API_BASE=
REACT_APP_ENVIRONMENT=production
GENERATE_SOURCEMAP=false
